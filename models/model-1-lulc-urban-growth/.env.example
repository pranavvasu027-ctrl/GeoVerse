# =============================================================================
# GeoVerse Model 1 — Supabase & Storage Environment Configuration Template
# =============================================================================
# DO NOT COMMIT REAL CREDENTIALS TO VERSION CONTROL.
# Copy this template to .env for local development:
#   cp .env.example .env
#
# Rule 5: Never expose SUPABASE_SERVICE_ROLE_KEY to browser clients.
# Rule 10: JSON storage remains active until explicit production rollout approval.
# =============================================================================

# Storage Backend Mode:
# Options: "json" (default, local atomic JSON files) | "supabase" (PostgreSQL database)
GEOVERSE_STORAGE_BACKEND=json

# Supabase Project Credentials (obtain from Supabase Dashboard > Settings > API)
SUPABASE_URL=https://your-project-id.supabase.co

# Service-Role Key (Used strictly server-side by Flask backend and migration CLI)
# WARNING: NEVER EXPOSE TO FRONTEND OR BROWSER JAVASCRIPT
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key-here

# Anonymous / Public Key (Read-only access for spatial reference queries)
SUPABASE_ANON_KEY=your-supabase-anon-public-key-here

# Fallback generic key variable (optional)
# SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Direct PostgreSQL Connection URL (optional, for running psql migrations directly)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.your-project-id.supabase.co:5432/postgres
